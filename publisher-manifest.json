ry::after {content: \"+\";position: absolute;right: 24px;top: 50%;transform: translateY(-50%);font-size: 18px;color: #38A37A;font-weight: bold}\n.faq-item[open] summary::after {content: \"-\"}\n.faq-content {padding: 0 24px 22px;font-size: 14px;color: #5C4C42;border-top: 1px solid #F5EFEA;padding-top: 14px}\nfooter {margin-top: 80px;padding-top: 24px;border-top: 1px solid #E4DDD6;font-size: 13px;color: #8C7B71;text-align: center}\n@media (max-width: 640px) {\n  .essay-hero h1 {font-size: 28px}\n  .essay-lead {font-size: 16px}\n  .plan-card {padding: 22px}\n  .plan-head {flex-direction: column;align-items: flex-start}\n  .plan-price-group {text-align: left}\n}\n</style><main class=\"page-container\">\n  <article class=\"essay-hero\">\n    <div class=\"essay-meta\">专栏记录 · 网络交付随笔</div>\n    <h1>泡芙：精简、克制，将数据管道交还给使用者</h1>\n    <p class=\"essay-lead\">多数时候，连接工具无需冗长的修饰词。它应当只是一条安分的通路。开箱，配置，确认，运行。仅此而已。</p>\n    <p class=\"essay-body\">泡芙始终维持扁平的数据交换准则。不搞虚浮噱头，不设繁杂门槛。我们在底层提供按需计费的传输容量，在上层保留最干净的手工导入机制。无论你需要的是偶尔查阅资料的轻量窗口，还是高频团队并发的工作环境，按规格选用即可。</p>\n    <nav class=\"essay-nav\" aria-label=\"页面段落直达\">\n      <a href=\"#plans\">查看方案档位</a>\n      <a href=\"#setup\">客户端设置指导</a>\n      <a href=\"#workflow\">三步工作流</a>\n      <a href=\"#questions\">常见疑问解答</a>\n    </nav>\n  </article>\n\n  <section id=\"plans\" class=\"section-block\">\n    <div class=\"section-header\">\n      <h2>方案规格与定价</h2>\n      <p>单列排列。各层级参数公开透明，按周期选订。</p>\n    </div>\n    <div class=\"stack-list\">\n      <article class=\"plan-card\">\n        <div class=\"plan-head\">\n          <div>\n            <h3>基础版</h3>\n          </div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥15 / 月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a href=\"#\" class=\"card-action\">选择基础版</a>\n      </article>\n\n      <article class=\"plan-card highlight\">\n        <span class=\"badge\">推荐规格</span>\n        <div class=\"plan-head\">\n          <div>\n            <h3>旗舰版</h3>\n          </div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥35 / 月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <a href=\"#\" class=\"card-action\">选择旗舰版</a>\n      </article>\n\n      <article class=\"plan-card\">\n        <div class=\"plan-head\">\n          <div>\n            <h3>团队版</h3>\n          </div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥85 / 月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n          </div>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <a href=\"#\" class=\"card-action\">选择团队版</a>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"setup\" class=\"section-block\">\n    <div class=\"section-header\">\n      <h2>通用客户端指引</h2>\n      <p>泡芙支持通用订阅协议，适配全平台第三方工具。</p>\n    </div>\n    <div class=\"info-card\">\n      <h3>平台适配说明</h3>\n      <p>泡芙不捆绑专属客户端软件。你可以在 macOS、Windows、iOS、Android 以及 Linux 等系统上，自由选用支持标准配置协议的第三方工具进行托管。</p>\n      <p>登录用户中心后复制配置订阅 URL，粘贴到所选工具的配置导入栏，刷新节点信息即可完成同步。自主可控，无需多余常驻进程。</p>\n    </div>\n  </section>\n\n  <section id=\"workflow\" class=\"section-block\">\n    <div class=\"section-header\">\n      <h2>接入步骤</h2>\n      <p>三次交互，快速建立通路。</p>\n    </div>\n    <div class=\"step-grid\">\n      <div class=\"step-item\">\n        <div class=\"step-num\">STEP 01</div>\n        <div class=\"step-title\">选定方案</div>\n        <div class=\"step-desc\">挑选匹配流量与并发数量的档位，完成订阅周期结算。</div>\n      </div>\n      <div class=\"step-item\">\n        <div class=\"step-num\">STEP 02</div>\n        <div class=\"step-title\">获取订阅</div>\n        <div class=\"step-desc\">进入控制面板。一键复制专属的协议链接或二维码。</div>\n      </div>\n      <div class=\"step-item\">\n        <div class=\"step-num\">STEP 03</div>\n        <div class=\"step-title\">载入使用</div>\n        <div class=\"step-desc\">在客户端中粘贴订阅并拉取节点列表，测试延迟后启用。</div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"questions\" class=\"section-block\">\n    <div class=\"section-header\">\n      <h2>常见问题</h2>\n      <p>点击展开，了解有关配置、流量与规则细节。</p>\n    </div>\n    <div class=\"faq-wrap\">\n      <details class=\"faq-item\">\n        <summary>每月流量用尽后会发生什么？</summary>\n        <div class=\"faq-content\">\n          当期流量到达额度上限后，接入通道将自动熔断暂停。你可以等待下一个账单日自动重置，或者在面板内购买临时叠加包恢复服务。\n        </div>\n      </details>\n      <details class=\"faq-item\">\n        <summary>可以跨设备同时登录使用吗？</summary>\n        <div class=\"faq-content\">\n          可以。各套餐已标明在线设备数量限制：基础版 3 台、旗舰版 5 台、团队版 20 台。请勿超出额定数量，以免触发连接频次风控。\n        </div>\n      </details>\n      <details class=\"faq-item\">\n        <summary>如何获取客户端配置参数？</summary>\n        <div class=\"faq-content\">\n          完成购买后进入个人中心，仪表盘内直接提供通用订阅地址。复制该地址并填入兼容客户端的订阅管理框内即可拉取。\n        </div>\n      </details>\n      <details class=\"faq-item\">\n        <summary>年付方案是否支持中途升档？</summary>\n        <div class=\"faq-content\">\n          支持。补齐剩余时间对应的差价后，系统会自动更新资源配额并立即同步新的节点权益。\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <footer>\n    <p>© 泡芙 · 网络接入服务指南 · 保留所有权利</p>\n  </footer>\n</main>",
